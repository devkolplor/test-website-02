---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Services — David Amayoor Architecture">
  <header class="max-w-6xl mx-auto px-6 py-6 flex items-center justify-between border-b border-border-subtle bg-white-surface/80 backdrop-blur-md sticky top-0 z-50">
    <div class="flex items-center space-x-3">
      <div class="w-7 h-7 bg-pink-brand rounded-chip flex items-center justify-center text-white font-bold text-xs">DA</div>
      <span class="text-hero-heading font-bold text-lg">David Amayoor</span>
    </div>
    <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-muted-text">
      <a href="/" class="hover:text-hero-heading transition-colors">Home</a>
      <a href="/services" class="text-pink-brand font-semibold">Services</a>
      <a href="/templates" class="hover:text-hero-heading transition-colors">Templates</a>
      <a href="/case-studies" class="hover:text-hero-heading transition-colors">Case Studies</a>
      <a href="/about" class="hover:text-hero-heading transition-colors">About</a>
    </nav>
    <a href="/contact" class="px-4 py-2 bg-pink-brand text-white text-sm font-semibold rounded-button shadow-sm hover:opacity-95">Book Call</a>
  </header>

  <main class="max-w-5xl mx-auto px-6 py-20 space-y-16">
    <div class="text-center space-y-4 max-w-2xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold text-hero-heading">High-Ticket Architecture Services</h1>
      <p class="text-muted-text text-lg">Bespoke digital workspace solutions engineered specifically for media agencies and solopreneurs.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Tier 1 -->
      <div class="p-8 bg-white-surface border border-border-subtle rounded-card space-y-6 shadow-sm flex flex-col justify-between">
        <div class="space-y-4">
          <span class="px-3 py-1 bg-chip-background text-xs font-mono font-bold text-pink-brand rounded-tag uppercase">Flagship Tier</span>
          <h3 class="text-2xl font-bold text-hero-heading">Full Life Notion OS</h3>
          <p class="text-muted-text text-sm leading-relaxed">
            The ultimate custom implementation combining PPV principles, advanced task tracking, client CRM, and financial metrics in one unified dashboard.
          </p>
          <ul class="space-y-2 text-sm text-body-text font-medium">
            <li class="flex items-center space-x-2"><span>✓</span><span>1-on-1 Discovery & Workflow Audit</span></li>
            <li class="flex items-center space-x-2"><span>✓</span><span>Custom Database Relations & Rollups</span></li>
            <li class="flex items-center space-x-2"><span>✓</span><span>Team Training & SOP Documentation</span></li>
          </ul>
        </div>
        <div class="pt-4 border-t border-border-subtle flex items-center justify-between">
          <div>
            <div class="text-xs text-muted-text">Starting at</div>
            <div class="text-2xl font-bold text-hero-heading">$2,500</div>
          </div>
          <a href="/contact" class="px-6 py-3 bg-pink-brand text-white font-semibold rounded-button text-sm hover:opacity-95">Inquire Now</a>
        </div>
      </div>

      <!-- Tier 2 -->
      <div class="p-8 bg-white-surface border border-border-subtle rounded-card space-y-6 shadow-sm flex flex-col justify-between">
        <div class="space-y-4">
          <span class="px-3 py-1 bg-chip-background text-xs font-mono font-bold text-pink-brand rounded-tag uppercase">Media Focus</span>
          <h3 class="text-2xl font-bold text-hero-heading">Video Studio OS</h3>
          <p class="text-muted-text text-sm leading-relaxed">
            Engineered for short-form video agencies to manage ideation, scriptwriting pipelines, editing statuses, and client feedback loops frictionlessly.
          </p>
          <ul class="space-y-2 text-sm text-body-text font-medium">
            <li class="flex items-center space-x-2"><span>✓</span><span>Content Pipeline Architecture</span></li>
            <li class="flex items-center space-x-2"><span>✓</span><span>Client Review & Approval Portal</span></li>
            <li class="flex items-center space-x-2"><span>✓</span><span>Editor Task Assignment Hub</span></li>
          </ul>
        </div>
        <div class="pt-4 border-t border-border-subtle flex items-center justify-between">
          <div>
            <div class="text-xs text-muted-text">Starting at</div>
            <div class="text-2xl font-bold text-hero-heading">$1,800</div>
          </div>
          <a href="/contact" class="px-6 py-3 bg-pink-brand text-white font-semibold rounded-button text-sm hover:opacity-95">Inquire Now</a>
        </div>
      </div>
    </div>
  </main>

  <footer class="max-w-5xl mx-auto px-6 py-12 border-t border-border-subtle text-center text-sm text-faint-text mt-20">
    <p>© 2026 David Amayoor. All rights reserved.</p>
  </footer>
</Layout>