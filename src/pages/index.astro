---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Second Brain OS — Capture, Organize, Distill, Express">
  
  <!-- Navigation Bar -->
  <header class="max-w-6xl mx-auto px-6 py-6 flex items-center justify-between">
    <div class="flex items-center space-x-2">
      <span class="w-3 h-3 bg-journiv-blue rounded-pill inline-block"></span>
      <span class="text-xl font-bold tracking-tight text-near-black">SecondBrain.os</span>
    </div>
    <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-dark-text-alt">
      <a href="#features" class="hover:text-journiv-blue transition-colors">Features</a>
      <a href="#framework" class="hover:text-journiv-blue transition-colors">PARA Method</a>
      <a href="#pricing" class="hover:text-journiv-blue transition-colors">Get System</a>
    </nav>
    <div>
      <a href="#pricing" class="px-5 py-2.5 bg-journiv-blue text-white text-sm font-semibold rounded-pill shadow-[0px_0px_20px_-5px_rgba(64,93,230,0.25)] hover:opacity-90 transition-opacity">
        Access OS
      </a>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-6 space-y-24 py-12">
    
    <!-- Hero Section -->
    <section class="text-center space-y-6 max-w-4xl mx-auto pt-12">
      <div class="inline-flex items-center space-x-2 px-3 py-1 bg-white-surface border border-border-subtle/50 rounded-pill text-xs font-bold text-journiv-blue shadow-sm">
        <span>⚡ Built for Deep Thinkers & Solopreneurs</span>
      </div>
      
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight text-near-black leading-[1.1]">
        Transform scattered notes into <span class="text-journiv-blue">actionable knowledge.</span>
      </h1>
      
      <p class="text-muted-gray text-lg md:text-xl font-normal max-w-2xl mx-auto leading-relaxed">
        The ultimate Second Brain operating system designed to capture ideas, organize your digital life, and execute your most important work with clarity.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a href="#pricing" class="w-full sm:w-auto px-8 py-4 bg-journiv-blue text-white font-semibold rounded-pill shadow-[0px_0px_24px_-6px_rgba(64,93,230,0.28)] hover:opacity-90 transition-opacity text-center">
          Get Your Second Brain
        </a>
        <a href="#framework" class="w-full sm:w-auto px-8 py-4 bg-white-surface text-near-black border border-border-subtle font-semibold rounded-pill hover:bg-page-background transition-colors text-center">
          Explore Framework
        </a>
      </div>

      <!-- Quick Command Bar Preview -->
      <div class="pt-8 flex justify-center">
        <div class="inline-flex items-center space-x-3 px-4 py-2 bg-white-surface border border-border-subtle/50 rounded-md text-sm text-muted-gray shadow-sm">
          <span>Quick search notes...</span>
          <code class="font-mono bg-page-background px-2 py-0.5 rounded-sm text-xs text-near-black border border-border-subtle/40">⌘K</code>
        </div>
      </div>
    </section>

    <!-- PARA Framework Section -->
    <section id="framework" class="space-y-12">
      <div class="text-center space-y-3">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-near-black">
          Powered by the PARA Method
        </h2>
        <p class="text-muted-gray text-base md:text-lg max-w-xl mx-auto">
          Every piece of information finds its exact home across four primary pillars.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Card 1: Projects -->
        <div class="p-8 bg-white-surface rounded-card border border-border-subtle/50 shadow-[0px_1px_3px_0px_rgba(0,0,0,0.06)] space-y-4 hover:border-journiv-blue/50 transition-all">
          <div class="w-10 h-10 rounded-md bg-page-background flex items-center justify-center text-journiv-blue font-bold text-lg">01</div>
          <h3 class="text-xl font-bold text-near-black">Projects</h3>
          <p class="text-dark-text-alt text-sm leading-relaxed">
            Short-term efforts with a specific goal and a deadline attached to your current workflow.
          </p>
        </div>

        <!-- Card 2: Areas -->
        <div class="p-8 bg-white-surface rounded-card border border-border-subtle/50 shadow-[0px_1px_3px_0px_rgba(0,0,0,0.06)] space-y-4 hover:border-journiv-blue/50 transition-all">
          <div class="w-10 h-10 rounded-md bg-page-background flex items-center justify-center text-journiv-blue font-bold text-lg">02</div>
          <h3 class="text-xl font-bold text-near-black">Areas</h3>
          <p class="text-dark-text-alt text-sm leading-relaxed">
            Long-term responsibilities that require continuous attention like health, finance, or business.
          </p>
        </div>

        <!-- Card 3: Resources -->
        <div class="p-8 bg-white-surface rounded-card border border-border-subtle/50 shadow-[0px_1px_3px_0px_rgba(0,0,0,0.06)] space-y-4 hover:border-journiv-blue/50 transition-all">
          <div class="w-10 h-10 rounded-md bg-page-background flex items-center justify-center text-journiv-blue font-bold text-lg">03</div>
          <h3 class="text-xl font-bold text-near-black">Resources</h3>
          <p class="text-dark-text-alt text-sm leading-relaxed">
            Topics of ongoing interest, reference materials, swipe files, and valuable templates.
          </p>
        </div>

        <!-- Card 4: Archives -->
        <div class="p-8 bg-white-surface rounded-card border border-border-subtle/50 shadow-[0px_1px_3px_0px_rgba(0,0,0,0.06)] space-y-4 hover:border-journiv-blue/50 transition-all">
          <div class="w-10 h-10 rounded-md bg-page-background flex items-center justify-center text-journiv-blue font-bold text-lg">04</div>
          <h3 class="text-xl font-bold text-near-black">Archives</h3>
          <p class="text-dark-text-alt text-sm leading-relaxed">
            Inactive items from the first three categories kept safely for future retrieval if needed.
          </p>
        </div>

      </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center py-12">
      <div class="space-y-6">
        <span class="text-xs font-bold uppercase tracking-wider text-journiv-blue">System Architecture</span>
        <h2 class="text-3xl md:text-4xl font-bold text-near-black leading-tight">
          Designed for maximum focus, zero cognitive friction.
        </h2>
        <p class="text-muted-gray leading-relaxed">
          Stop wasting hours organizing folders. Our system uses automated linking, minimalist typography, and lightning-fast capture flows so you can focus entirely on creating output.
        </p>
        <ul class="space-y-3 text-dark-text-alt font-medium text-sm">
          <li class="flex items-center space-x-3">
            <span class="w-2 h-2 bg-journiv-blue rounded-pill"></span>
            <span>Frictionless Web Clipper & Quick Capture</span>
          </li>
          <li class="flex items-center space-x-3">
            <span class="w-2 h-2 bg-journiv-blue rounded-pill"></span>
            <span>Progressive Summarization workflow built-in</span>
          </li>
          <li class="flex items-center space-x-3">
            <span class="w-2 h-2 bg-journiv-blue rounded-pill"></span>
            <span>100% Private, self-hosted or local markdown ready</span>
          </li>
        </ul>
      </div>

      <div class="p-8 bg-white-surface rounded-card border border-border-subtle/50 shadow-[0px_1px_3px_0px_rgba(0,0,0,0.06)] space-y-6">
        <div class="flex items-center justify-between border-b border-border-subtle/40 pb-4">
          <span class="text-xs font-bold text-muted-gray uppercase">Active Workspace</span>
          <span class="px-2.5 py-1 bg-journiv-blue/10 text-journiv-blue text-xs font-bold rounded-pill">Sync Live</span>
        </div>
        <div class="space-y-3">
          <div class="p-3 bg-page-background rounded-md text-sm font-semibold text-near-black">🧠 Daily Knowledge Review</div>
          <div class="p-3 bg-page-background rounded-md text-sm font-semibold text-near-black">🚀 Q3 Product Launch Roadmap</div>
          <div class="p-3 bg-page-background rounded-md text-sm font-semibold text-near-black">💡 Content Ideas & Swipe Files</div>
        </div>
      </div>
    </section>

    <!-- Pricing / CTA Section -->
    <section id="pricing" class="py-12 text-center">
      <div class="max-w-2xl mx-auto p-10 bg-white-surface rounded-section border border-border-subtle/50 shadow-[0px_1px_3px_0px_rgba(0,0,0,0.06)] space-y-6">
        <h2 class="text-3xl font-bold text-near-black">Ready to upgrade your mind?</h2>
        <p class="text-muted-gray text-sm md:text-base">
          Get lifetime access to the complete Second Brain operating system files, documentation, and layout templates.
        </p>
        <div>
          <button class="px-8 py-4 bg-journiv-blue text-white font-semibold rounded-pill shadow-[0px_0px_24px_-6px_rgba(64,93,230,0.28)] hover:opacity-90 transition-opacity">
            Get Instant Access — $49
          </button>
        </div>
        <p class="text-xs text-muted-gray">Instant download • Works with Markdown & Notion setups</p>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="max-w-6xl mx-auto px-6 py-12 border-t border-border-subtle/40 text-center text-sm text-muted-gray">
    <p>© 2026 SecondBrain.os. Built with Astro & Journiv Light Design System.</p>
  </footer>

</Layout>