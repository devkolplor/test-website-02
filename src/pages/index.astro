---
import Layout from '../layouts/Layout.astro';
---
<Layout title="David Amayoor — Notion System Architecture">
  <!-- Navigation -->
  <header class="max-w-6xl mx-auto px-6 py-6 flex items-center justify-between border-b border-border-subtle bg-white-surface/80 backdrop-blur-md sticky top-0 z-50">
    <div class="flex items-center space-x-3">
      <div class="w-7 h-7 bg-pink-brand rounded-chip flex items-center justify-center text-white font-bold text-xs">DA</div>
      <span class="text-hero-heading font-bold text-lg">David Amayoor</span>
    </div>
    <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-muted-text">
      <a href="/" class="text-pink-brand font-semibold">Home</a>
      <a href="/services" class="hover:text-hero-heading transition-colors">Services</a>
      <a href="/templates" class="hover:text-hero-heading transition-colors">Templates</a>
      <a href="/case-studies" class="hover:text-hero-heading transition-colors">Case Studies</a>
      <a href="/about" class="hover:text-hero-heading transition-colors">About</a>
    </nav>
    <a href="/contact" class="px-4 py-2 bg-pink-brand text-white text-sm font-semibold rounded-button shadow-sm hover:opacity-95">Book Call</a>
  </header>

  <main class="max-w-5xl mx-auto px-6 py-20 space-y-28">
    
    <!-- Hero Section -->
    <section class="text-center space-y-8">
      <div class="inline-flex items-center space-x-2 px-3 py-1 bg-chip-background border border-border-subtle rounded-pill text-xs font-semibold text-pink-brand uppercase tracking-wider">
        <span>⚡ Precision-Engineered Digital Workspaces</span>
      </div>
      <h1 class="text-5xl md:text-7xl lg:text-[80px] font-bold text-hero-heading tracking-tight leading-[1.1]">
        Transforming operational chaos into <span class="text-pink-brand">pure clarity.</span>
      </h1>
      <p class="text-muted-text text-lg md:text-xl max-w-2xl mx-auto leading-relaxed">
        With 7 years of deep Notion architecture experience, I apply biochemical precision to build high-performance operating systems for solopreneurs and media teams.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4 pt-4">
        <a href="/services" class="px-8 py-4 bg-pink-brand text-white font-semibold rounded-button shadow-md hover:opacity-95 text-center">Explore High-Ticket Services</a>
        <a href="/templates" class="px-8 py-4 bg-white-surface border border-border-subtle text-hero-heading font-semibold rounded-button hover:bg-chip-background text-center">Browse Namogolyst Templates</a>
      </div>
    </section>

    <!-- Framework Pillars Section -->
    <section class="space-y-12">
      <div class="text-center space-y-3">
        <span class="text-xs font-mono font-bold text-pink-brand uppercase tracking-widest">Architectural Foundation</span>
        <h2 class="text-3xl md:text-4xl font-bold text-hero-heading">Built on Proven Frameworks</h2>
        <p class="text-muted-text max-w-lg mx-auto">August Bradley's PPV and Tiago Forte's PARA methodologies integrated seamlessly for maximum leverage.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-8 bg-white-surface border border-border-subtle rounded-card space-y-4 shadow-sm">
          <div class="w-10 h-10 bg-chip-background rounded-chip flex items-center justify-center text-pink-brand font-bold">01</div>
          <h3 class="text-xl font-bold text-hero-heading">Pillars & Pipelines</h3>
          <p class="text-muted-text text-sm leading-relaxed">Align your daily actions with long-term life objectives using structured content pipelines.</p>
        </div>
        <div class="p-8 bg-white-surface border border-border-subtle rounded-card space-y-4 shadow-sm">
          <div class="w-10 h-10 bg-chip-background rounded-chip flex items-center justify-center text-pink-brand font-bold">02</div>
          <h3 class="text-xl font-bold text-hero-heading">PARA Organization</h3>
          <p class="text-muted-text text-sm leading-relaxed">Projects, Areas, Resources, and Archives cleanly partitioned to eliminate cognitive friction.</p>
        </div>
        <div class="p-8 bg-white-surface border border-border-subtle rounded-card space-y-4 shadow-sm">
          <div class="w-10 h-10 bg-chip-background rounded-chip flex items-center justify-center text-pink-brand font-bold">03</div>
          <h3 class="text-xl font-bold text-hero-heading">Cyber-Minimalism</h3>
          <p class="text-muted-text text-sm leading-relaxed">Dark-mode ready, distraction-free typography and clean layouts tailored for high focus.</p>
        </div>
      </div>
    </section>

    <!-- Core Solutions / Services Preview -->
    <section class="space-y-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div class="space-y-3">
          <span class="text-xs font-mono font-bold text-pink-brand uppercase tracking-widest">Client Solutions</span>
          <h2 class="text-3xl md:text-4xl font-bold text-hero-heading">Engineered for Scale</h2>
        </div>
        <a href="/services" class="text-sm font-semibold text-pink-brand hover:underline">View all services →</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-8 bg-white-surface border border-border-subtle rounded-card space-y-4 shadow-sm">
          <span class="px-3 py-1 bg-chip-background text-xs font-mono font-bold text-pink-brand rounded-tag uppercase">Flagship</span>
          <h3 class="text-2xl font-bold text-hero-heading">Full Life Notion OS</h3>
          <p class="text-muted-text text-sm leading-relaxed">Complete integration of PPV and advanced task tracking tailored specifically for high-achieving solopreneurs.</p>
          <div class="text-xl font-bold text-hero-heading pt-2">$2,500 <span class="text-xs text-muted-text font-normal">/ project</span></div>
        </div>
        <div class="p-8 bg-white-surface border border-border-subtle rounded-card space-y-4 shadow-sm">
          <span class="px-3 py-1 bg-chip-background text-xs font-mono font-bold text-pink-brand rounded-tag uppercase">Media Focus</span>
          <h3 class="text-2xl font-bold text-hero-heading">Video Studio OS</h3>
          <p class="text-muted-text text-sm leading-relaxed">Specialized content pipeline architecture built for short-form video production agencies and creators.</p>
          <div class="text-xl font-bold text-hero-heading pt-2">$1,800 <span class="text-xs text-muted-text font-normal">/ project</span></div>
        </div>
      </div>
    </section>

    <!-- Testimonial / Social Proof -->
    <section class="p-10 bg-white-surface border border-border-subtle rounded-card-lg space-y-6 shadow-sm text-center max-w-3xl mx-auto">
      <span class="text-xs font-mono font-bold text-pink-brand uppercase tracking-widest">Client Success</span>
      <p class="text-hero-heading text-lg md:text-xl italic leading-relaxed">
        "Implementing David's Video Studio OS saved our agency over 15 hours weekly. The structure completely eliminated communication friction across our editing team."
      </p>
      <div>
        <h4 class="font-bold text-hero-heading">Short-Form Agency Founder</h4>
        <span class="text-xs text-muted-text">Verified Client Build</span>
      </div>
    </section>

    <!-- Bottom CTA Banner -->
    <section class="p-12 bg-pink-tint-surface border border-pink-brand/30 rounded-card-lg text-center space-y-6">
      <h2 class="text-3xl font-bold text-hero-heading">Ready to upgrade your digital workspace?</h2>
      <p class="text-muted-text max-w-xl mx-auto">Book a discovery call today to discuss your custom architecture requirements.</p>
      <a href="/contact" class="inline-block px-8 py-4 bg-pink-brand text-white font-semibold rounded-button shadow-md hover:opacity-95">Book Your Discovery Call</a>
    </section>

  </main>

  <footer class="max-w-5xl mx-auto px-6 py-12 border-t border-border-subtle text-center text-sm text-faint-text">
    <p>© 2026 David Amayoor. Notion System Architect. All rights reserved.</p>
  </footer>
</Layout>