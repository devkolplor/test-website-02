---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Maxun - Developer Tools" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Geist & Geist Mono Fonts from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400&family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body class="bg-pink-tint-surface text-body-text min-h-screen antialiased selection:bg-pink-brand selection:text-white">
    <slot />
  </body>
</html>